# Server
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/crm_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-jwt-secret-here

# WhatsApp Cloud API (Meta)
# Dapatkan dari: Meta Business Manager → Apps → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-permanent-system-user-token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=buat-token-acak-sendiri-bebas

# WhatsApp Business Account ID (opsional, untuk referensi)
WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id

# API key untuk integrasi eksternal (n8n, script, dll) kirim pesan lewat
# POST /api/messages/send-external (header X-API-Key). Buat random string sendiri.
INTEGRATION_API_KEY=buat-random-string-sendiri

# Google Cloud Storage (S3-compatible interoperability API) — dipakai untuk simpan
# gambar/video/dokumen chat masuk & keluar. Access key didapat dari:
# Cloud Storage → Settings → Service account HMAC → Access keys for service accounts
GCS_ACCESS_KEY_ID=change-me
GCS_SECRET_ACCESS_KEY=change-me
GCS_REGION=auto
GCS_BUCKET=change-me
GCS_ENDPOINT=https://storage.googleapis.com
# Folder prefix di dalam bucket tempat menyimpan media chat
GCS_FOLDER_PREFIX=Waku/messages
