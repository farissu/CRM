# Server
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/crm_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-jwt-secret-here

# WhatsApp Cloud API (Meta)
# Dapatkan dari: Meta Business Manager → Apps → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-permanent-system-user-token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=buat-token-acak-sendiri-bebas

# WhatsApp Business Account ID (opsional, untuk referensi)
WHATSAPP_BUSINESS_ACCOUNT_ID=4037969179836700

# App ID & App Secret dari Meta App Dashboard → Settings → Basic
# WHATSAPP_APP_SECRET wajib diisi supaya webhook signature (X-Hub-Signature-256) diverifikasi.
# Tanpa ini, endpoint webhook menerima payload apapun tanpa memverifikasi asalnya dari Meta.
WHATSAPP_APP_ID=your-meta-app-id
WHATSAPP_APP_SECRET=your-meta-app-secret
