# Template env untuk 1 klien/tenant baru.
# Copy file ini ke clients/<nama-klien>.env lalu isi semua nilainya.
# Setiap klien WAJIB punya: nama klien unik, port unik (kalau 1 klien lain
# sudah jalan di VPS yang sama), dan database yang benar-benar terpisah.

# JWT Secret (random string panjang, beda per klien)
JWT_SECRET=GANTI_DENGAN_RANDOM_STRING_YANG_SANGAT_PANJANG_DAN_AMAN

# Database PostgreSQL milik klien ini
DB_USER=postgres
DB_PASSWORD=GANTI_DENGAN_PASSWORD_RANDOM_KUAT
DB_NAME=whatsapp_crm_nama_klien

# Port host (WAJIB unik per klien kalau berbagi 1 VPS dengan klien lain)
DB_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=3001
FRONTEND_PORT=3000

# URL Frontend & Backend untuk CORS dan Client-side Next.js
FRONTEND_URL=https://nama-klien.domainkamu.com
NEXT_PUBLIC_API_URL=https://nama-klien.domainkamu.com
NEXT_PUBLIC_WS_URL=wss://nama-klien.domainkamu.com

# Token Integrasi WhatsApp Cloud API (Meta) milik klien ini
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-long-lived-access-token
WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=GANTI_DENGAN_TOKEN_VERIFIKASI_UNIK
